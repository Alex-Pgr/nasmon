# Optional host-specific nasmon configuration.
# Copy to /etc/nasmon/nasmon.env and uncomment only values you need.

# Preferred network interface. Leave unset for default-route autodetection.
# NAS_INTERFACE=enp1s0

# Optional privileged/vendor-specific GPU helper. Leave unset to disable it.
# GPU_INFO_HELPER=/usr/local/bin/nas-gpu-info

# Filesystem highlighted by Storage Analysis. Generic default is /.
# STORAGE_PATH=/mnt/data

# Comma-separated mount paths shown in Disk Usage. Generic default is /.
# DISK_PATHS=/,/mnt/data,/mnt/archive

# Shared daemon state. Normally there is no reason to change this.
# NAS_STATE_FILE=/run/nasmon/state.json

# Collector intervals, in seconds.
# MAIN_INTERVAL=2
# GPU_INTERVAL=10
# DOCKER_INTERVAL=30
# DISK_LAYOUT_INTERVAL=15
# DISK_POWER_INTERVAL=60
# DISK_TEMP_INTERVAL=900
# DISK_QUIET_WINDOW=300
# SMART_INTERVAL=3600
# SYSTEMD_INTERVAL=30
# IP_INTERVAL=60
