[Unit]
Description=NAS Monitor collector daemon
After=network.target

[Service]
Type=simple
# For manual installation, replace YOUR_USER with the account that should
# access Docker and any configured hardware helpers. install.sh fills this in.
User=YOUR_USER
EnvironmentFile=-/etc/nasmon/nasmon.env
RuntimeDirectory=nasmon
RuntimeDirectoryMode=0700
ExecStart=/usr/local/bin/nasmond
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
